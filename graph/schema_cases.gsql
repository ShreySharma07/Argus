// Agent-written case memory (M4). Named AgentCase because "Case" is a GSQL reserved word. Option B: separate from the bank's ClosedCase history.
USE GRAPH {GRAPH}
CREATE SCHEMA_CHANGE JOB add_case_layer FOR GRAPH {GRAPH} {
  ADD VERTEX AgentCase (PRIMARY_ID id STRING, case_id STRING, card_id STRING, customer_id STRING,
    opened_at DATETIME, trigger_type STRING, status STRING, verdict STRING, fraud_probability DOUBLE,
    pattern STRING, exposure_usd DOUBLE, sar_filed BOOL, summary STRING, record STRING)
    WITH primary_id_as_attribute="true";
  ADD DIRECTED EDGE CASE_ON_CARD (FROM AgentCase, TO Card) WITH REVERSE_EDGE="CARD_AGENT_CASE";
  ADD DIRECTED EDGE CASE_TXN (FROM AgentCase, TO Transaction) WITH REVERSE_EDGE="TXN_AGENT_CASE";
  ADD DIRECTED EDGE CASE_CONNECTED (FROM AgentCase, TO Card) WITH REVERSE_EDGE="CONNECTED_AGENT_CASE";
  ADD DIRECTED EDGE CASE_SIMILAR (FROM AgentCase, TO ClosedCase) WITH REVERSE_EDGE="SIMILAR_AGENT_CASE";
  ADD DIRECTED EDGE CASE_PATTERN (FROM AgentCase, TO FraudPattern) WITH REVERSE_EDGE="PATTERN_AGENT_CASE";
  ADD DIRECTED EDGE CASE_DEVICE (FROM AgentCase, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_AGENT_CASE";
}
RUN SCHEMA_CHANGE JOB add_case_layer
DROP JOB add_case_layer
CREATE SCHEMA_CHANGE JOB add_case_summary_emb FOR GRAPH {GRAPH} {
  ALTER VERTEX AgentCase ADD VECTOR ATTRIBUTE summary_emb(DIMENSION=384, METRIC="COSINE");
}
RUN SCHEMA_CHANGE JOB add_case_summary_emb
DROP JOB add_case_summary_emb
