// Entity + prior-case schema (M1). Knowledge layer is in schema_knowledge.gsql.
// Agent case write-back types (Case, Evidence, Action) are added with M3/M4.
//
// Missing numeric values are loaded as -999 (see etl/prepare.py MISSING),
// because TigerGraph would otherwise default them to 0, which is a real value
// for the C/D/id_ features.
USE GRAPH {GRAPH}
CREATE SCHEMA_CHANGE JOB add_entity_layer FOR GRAPH {GRAPH} {
  ADD VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";

  // card_id = <customer_id>-K<n>, n from sorted distinct (card4, card6) per customer
  ADD VERTEX Card (PRIMARY_ID id STRING, customer_id STRING, network STRING, card_type STRING)
    WITH primary_id_as_attribute="true";

  ADD VERTEX Transaction (PRIMARY_ID id STRING,
    dt INT, ts DATETIME, amount DOUBLE, product_cd STRING, channel STRING, risk_score DOUBLE,
    card_id STRING, customer_id STRING, card2 STRING, card3 STRING, card5 STRING,
    addr1 STRING, addr2 STRING, dist1 DOUBLE, dist2 DOUBLE, p_email STRING, r_email STRING,
    C1 DOUBLE, C2 DOUBLE, C3 DOUBLE, C4 DOUBLE, C5 DOUBLE, C6 DOUBLE, C7 DOUBLE,
    C8 DOUBLE, C9 DOUBLE, C10 DOUBLE, C11 DOUBLE, C12 DOUBLE, C13 DOUBLE, C14 DOUBLE,
    D1 DOUBLE, D2 DOUBLE, D3 DOUBLE, D4 DOUBLE, D5 DOUBLE, D6 DOUBLE, D7 DOUBLE, D8 DOUBLE,
    D9 DOUBLE, D10 DOUBLE, D11 DOUBLE, D12 DOUBLE, D13 DOUBLE, D14 DOUBLE, D15 DOUBLE,
    M1 STRING, M2 STRING, M3 STRING, M4 STRING, M5 STRING, M6 STRING, M7 STRING, M8 STRING, M9 STRING,
    has_identity BOOL, device_type STRING,
    id_01 DOUBLE, id_02 DOUBLE, id_03 DOUBLE, id_04 DOUBLE, id_05 DOUBLE, id_06 DOUBLE,
    id_07 DOUBLE, id_08 DOUBLE, id_09 DOUBLE, id_10 DOUBLE, id_11 DOUBLE,
    id_12 STRING, id_15 STRING, id_16 STRING, id_23 STRING, id_27 STRING, id_28 STRING,
    id_29 STRING, id_34 STRING, id_35 STRING, id_36 STRING, id_37 STRING, id_38 STRING)
    WITH primary_id_as_attribute="true";

  // id = "DeviceInfo | OS | browser | screen" (answer-file format for connected_device_profiles)
  ADD VERTEX DeviceProfile (PRIMARY_ID id STRING, device_info STRING, os STRING, browser STRING, screen STRING)
    WITH primary_id_as_attribute="true";
  ADD VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";

  ADD VERTEX ClosedCase (PRIMARY_ID id STRING,
    customer_id STRING, card_id STRING, opened_at DATETIME, closed_at DATETIME,
    outcome STRING, pattern STRING, first_fraud_txn_id STRING, n_txns INT, exposure_usd DOUBLE,
    actions_taken STRING, report_filed BOOL, analyst_notes STRING)
    WITH primary_id_as_attribute="true";

  ADD DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY";
  ADD DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY";
  ADD DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, gap_s INT) WITH REVERSE_EDGE="PREV";
  ADD DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_OF";
  ADD DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="PURCHASER_EMAIL_OF";
  ADD DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="RECIPIENT_EMAIL_OF";
  ADD DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_OF";

  ADD DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN";
  ADD DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_CASE";
  ADD DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CASE";
  ADD DIRECTED EDGE MATCHES (FROM ClosedCase, TO FraudPattern) WITH REVERSE_EDGE="MATCHED_BY";
}
RUN SCHEMA_CHANGE JOB add_entity_layer
DROP JOB add_entity_layer
