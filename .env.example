# --- TigerGraph Savanna (read by tigergraph-mcp and pyTigerGraph) ---
# Host is the Savanna workspace URL, e.g. https://<workspace-id>.i.tgcloud.io
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPHNAME=FraudGraph
TG_TGCLOUD=true
# Auth: either a GSQL secret (preferred on Savanna) or username/password.
TG_SECRET=
TG_USERNAME=
TG_PASSWORD=
# Savanna serves RESTPP and GSQL over 443
TG_RESTPP_PORT=443
TG_GS_PORT=443

# --- Local paths ---
DATA_DIR=/Users/shreysharma/Desktop/tiger

# --- LLM ---
ANTHROPIC_API_KEY=

# --- LLM provider: anthropic (default) or gemini ---
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
